name = "keep-custom-name"
description = "Do not replace this description"

parameter "Environment" {
    default_value = "Production"
    help_text = "Environment selector"
    label = "Environment"
}

step "custom-prod-step" {
    name = "Custom Prod Step"
    properties = {
        Octopus.Action.TargetRoles = "#{Environment}"
        Octopus.Action.EnabledFeatures = "Octopus.Features.Custom"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = "printf \"legacy\"\\n"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            Octopus.Action.CustomProperty = "preserve-me"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = "CustomPool"
    }
}
